# Copia este archivo a .env y rellena tus claves reales.
# El archivo .env NO debe subirse a git (ver .gitignore).

# --- Azure OpenAI (Azure AI Foundry) ---
# Endpoint del recurso, p.ej. https://mi-recurso.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
# Clave del recurso (Keys and Endpoint en el portal / Foundry)
AZURE_OPENAI_API_KEY=...
# Versión de API que muestra tu deployment (ej. 2024-10-21)
OPENAI_API_VERSION=2024-10-21
# NOMBRE DEL DEPLOYMENT que diste a gpt-4o (no necesariamente "gpt-4o")
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Tavily (búsqueda web) ---
TAVILY_API_KEY=tvly-...
